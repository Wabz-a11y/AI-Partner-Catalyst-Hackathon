{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",                
    "moduleResolution": "node16",     
    "outDir": "./dist",
    "rootDir": "./server",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false // default — we removed .ts from imports
  },
  "include": ["server/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}